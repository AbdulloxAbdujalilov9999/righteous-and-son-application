{
  "name": "righteous-and-son-application",
  "version": "1.0.0",
  "description": "Driver application and consent forms for Righteous and Son Inc",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "esbuild lib/pdf/browser.js --bundle --minify --format=iife --platform=browser --target=es2019 --outfile=public/js/pdf.bundle.js && npm run vendor",
    "sample": "node scripts/sample.js",
    "vendor": "mkdir -p public/vendor/pdfjs && cp node_modules/pdfjs-dist/build/pdf.min.js node_modules/pdfjs-dist/build/pdf.worker.min.js public/vendor/pdfjs/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^3.11.174"
  }
}
