# --- Automatic email of submitted applications (optional) ---
# Leave these unset and the site falls back to "Download PDF" (the applicant emails it themselves).

# Option 1: Gmail (needs 2-Step Verification + an App Password: myaccount.google.com/apppasswords)
SMTP_USER=righteousandson.inc@gmail.com
SMTP_PASS=

# Option 2: another SMTP service such as Brevo (no 2-Step Verification needed)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<your Brevo SMTP login>
# SMTP_PASS=<your Brevo SMTP key>
# MAIL_FROM=righteousandson.inc@gmail.com     # a sender address verified with the service

# Optional: override the recipients (comma-separated)
# MAIL_TO=righteousandson.inc@gmail.com, jscott.righteousandson@gmail.com

# Local testing only: build the email but do not send it
# DRY_RUN=1
